{"id": "bio-023", "type": "biography", "title": "部分子模型", "text": "1969年前后提出部分子模型，解释深度非弹性散射，后来被理解为夸克。", "tags": ["生平", "传记", "物理", "部分子"], "source": "整理，未在语料中核对", "year": 1969, "beyond_1946": true, "aliases": ["夸克", "深度非弹性", "部分子"], "source_class": "project_compilation", "verification_status": "unreviewed", "source_note": "未归类，按项目整理处理", "claims": [], "claims_skipped": [], "claim_coverage": {"schema": 6, "chars": 34, "person_mentions": 0, "relation_words": 0, "relation_attachable": 0, "relation_claims": 0, "relation_skipped": 0, "relation_ratio": null, "dated_claims": 0, "year_mentions": 1, "quantity_claims": 0, "quantity_mentions": 0, "stance_mentions": 0, "stance_claims": 0, "stance_skipped": 0}, "claims_schema": 6, "claims_text_hash": "0afb3c789420a9dc"}
