  "stem": {
    "ies_suffix": "ies",
    "ied_suffix": "ied",
    "suffixes": ["ation", "ition", "ance", "ence", "ing", "ed", "es", "s"],
    "passes": 2,
    "min_stem_remainder": 2,
    "trailing_e_min_length": 3
  },
  "intents": [
    {
      "pattern": "\\b(who are you|what are you|your name|introduce yourself)\\b",
      "ignore_case": true,
      "tokens": "selfidentity"
    },
    {
      "pattern": "\\b(what is science|scientific method|how science works)\\b",
      "ignore_case": true,
      "tokens": "sciencemethod"
    },
    {
      "pattern": "\\b(memory|forget|forgot|recall)\\b",
      "ignore_case": true,
      "tokens": "memory remembering forgetting"
    }
  ],
  "terms": [],
  "bridge": []
}
