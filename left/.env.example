# 填入 DeepSeek API Key；留空则自动启用内置高精度物理/形式化离线仿真内核
DEEPSEEK_API_KEY=

# 模型分层配置（并发探索与 Map 审计用 deepseek-chat，Reduce 聚类与裁决同样用 deepseek-chat，可换成 deepseek-reasoner）
WORKER_MODEL=deepseek-chat
AUDITOR_MODEL=deepseek-chat

# DeepSeek 兼容接口地址（默认官方；如走代理/中转可覆盖）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# /solve 结果缓存：秒数（0 关闭）与落盘路径
QBOT_CACHE_TTL_SEC=3600
# QBOT_CACHE_PATH=data/solve_cache.json

# LLM 调用预算：进程累计上限 / 单次请求上限（留空或负数 = 不限）
# QBOT_MAX_LLM_CALLS=200
# QBOT_MAX_LLM_CALLS_PER_SOLVE=12

# 量子活字印刷机：字库落盘路径（最多缓存 32 盘字粒）
# QBOT_FONT_BANK_PATH=data/font_banks.json

# 费曼心智活字：本地语料、结构化知识目录、铸好的字库路径
# QBOT_FEYNMAN_CORPUS=~/Desktop/费曼物理_文字版/corpus/cpt_zh.jsonl
# QBOT_FEYNMAN_KNOWLEDGE=~/Projects/feynman-open/knowledge
# QBOT_FEYNMAN_VAULT=data/feynman_style_vault.json

# 需要 Mathlib 战术时，指向一个 lake 项目目录，Lean 验证改走 `lake env lean`
# QBOT_LEAN_PROJECT=/path/to/lake/project
