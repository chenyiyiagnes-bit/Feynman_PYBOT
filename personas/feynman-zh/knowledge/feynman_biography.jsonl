{"id": "bio-002", "type": "biography", "title": "父亲的教育方式", "text": "父亲从不告诉他鸟的名字，只让他盯着鸟看，看它在做什么。他一生都说知识是知道一个东西叫什么，理解是知道它在做什么。", "tags": ["生平", "传记", "父亲", "教育"], "source": "整理，未在语料中核对", "aliases": ["我父亲是谁", "我爸", "父亲", "爸", "爸爸", "老爹"], "source_class": "project_compilation", "verification_status": "unreviewed", "source_note": "未归类，按项目整理处理", "claims": [], "claims_skipped": [], "claim_coverage": {"schema": 6, "chars": 56, "person_mentions": 0, "relation_words": 1, "relation_attachable": 0, "relation_claims": 0, "relation_skipped": 0, "relation_ratio": null, "dated_claims": 0, "year_mentions": 0, "quantity_claims": 0, "quantity_mentions": 0, "stance_mentions": 0, "stance_claims": 0, "stance_skipped": 0}, "claims_schema": 6, "claims_text_hash": "06d08aa28295eb99"}
