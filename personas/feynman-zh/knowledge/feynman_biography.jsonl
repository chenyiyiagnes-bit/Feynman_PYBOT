{"id": "bio-004", "type": "biography", "title": "认识阿琳", "text": "阿琳·格林鲍姆是他在法洛克威的高中恋人。他给她讲物理，她给他讲艺术和文学。", "tags": ["生平", "传记", "阿琳", "恋爱"], "source": "整理，未在语料中核对", "aliases": ["你们怎么认识的", "阿琳是谁", "高中恋人"], "source_class": "project_compilation", "verification_status": "unreviewed", "source_note": "未归类，按项目整理处理", "claims": [{"kind": "relation", "person": "阿琳·格林鲍姆", "relation": "恋人", "word": "恋人", "polarity": "assert", "span": [17, 19], "quote": "恋人", "clause": "阿琳·格林鲍姆是他在法洛克威的高中恋人", "direction": "direct"}], "claims_skipped": [], "claim_coverage": {"schema": 6, "chars": 37, "person_mentions": 2, "relation_words": 1, "relation_attachable": 1, "relation_claims": 1, "relation_skipped": 0, "relation_ratio": 1.0, "dated_claims": 0, "year_mentions": 0, "quantity_claims": 0, "quantity_mentions": 0, "stance_mentions": 0, "stance_claims": 0, "stance_skipped": 0}, "claims_schema": 6, "claims_text_hash": "87a077a110d6234f"}
{"id": "bio-005", "type": "biography", "title": "与阿琳结婚", "text": "1942年6月29日，他与阿琳·格林鲍姆结婚。那时他已经知道她患了结核病。", "tags": ["生平", "传记", "阿琳", "婚姻"], "source": "《理查德·费曼传》劳伦斯·M·克劳斯 p.81", "aliases": ["什么时候结的婚", "娶", "婚礼", "成家", "结婚", "结的婚"], "source_class": "project_compilation", "verification_status": "unreviewed", "source_note": "未归类，按项目整理处理", "claims": [], "claims_skipped": [], "claim_coverage": {"schema": 6, "chars": 37, "person_mentions": 2, "relation_words": 0, "relation_attachable": 0, "relation_claims": 0, "relation_skipped": 0, "relation_ratio": null, "dated_claims": 0, "year_mentions": 1, "quantity_claims": 0, "quantity_mentions": 0, "stance_mentions": 0, "stance_claims": 0, "stance_skipped": 0}, "claims_schema": 6, "claims_text_hash": "eee5d31c327b255a"}
