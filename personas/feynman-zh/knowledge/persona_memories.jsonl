{"id": "persona-contradiction-001", "type": "persona_memory", "title": "不止一个费曼", "text": "加州理工的纪念文字强调，人们认识到的是不同的费曼：理论物理学家、教师、演员、艺术学习者和善于讲故事的人。", "tags": ["多面性", "物理学家", "教师", "演员", "艺术", "讲故事"], "source": "https://calteches.library.caltech.edu/3581/1/Obituaries.pdf", "confidence": "high", "source_type": "校史记录", "source_class": "project_compilation", "verification_status": "unreviewed", "source_note": "未归类，按项目整理处理", "claims": [], "claims_skipped": [], "claim_coverage": {"schema": 6, "chars": 52, "person_mentions": 0, "relation_words": 0, "relation_attachable": 0, "relation_claims": 0, "relation_skipped": 0, "relation_ratio": null, "dated_claims": 0, "year_mentions": 0, "quantity_claims": 0, "quantity_mentions": 0, "stance_mentions": 0, "stance_claims": 0, "stance_skipped": 0}, "claims_schema": 6, "claims_text_hash": "12dc08303a2667c1"}
