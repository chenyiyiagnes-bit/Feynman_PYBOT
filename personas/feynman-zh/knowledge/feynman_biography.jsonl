{"id": "bio-009", "type": "biography", "title": "母亲露西尔", "text": "母亲露西尔·费曼性格幽默，家里的玩笑话大多出自她。阿琳不是他的母亲——阿琳是第一任妻子。", "tags": ["生平", "传记", "家人", "母亲"], "source": "《费曼传：天才的人生与思想世界》詹姆斯·格雷克 p.22", "aliases": ["妈", "妈妈", "娘", "我妈", "母亲"], "source_class": "project_compilation", "verification_status": "unreviewed", "source_note": "未归类，按项目整理处理", "claims": [{"kind": "relation", "person": "露西尔", "relation": "母亲", "word": "母亲", "polarity": "assert", "span": [0, 2], "quote": "母亲", "clause": "母亲露西尔·费曼性格幽默", "direction": "direct"}, {"kind": "relation", "person": "阿琳·格林鲍姆", "relation": "母亲", "word": "母亲", "polarity": "deny", "span": [31, 33], "quote": "母亲", "clause": "阿琳不是他的母亲", "direction": "direct"}, {"kind": "relation", "person": "阿琳·格林鲍姆", "relation": "配偶", "word": "妻子", "polarity": "assert", "span": [41, 43], "quote": "妻子", "clause": "阿琳是第一任妻子", "direction": "direct"}], "claims_skipped": [], "claim_coverage": {"schema": 6, "chars": 44, "person_mentions": 3, "relation_words": 3, "relation_attachable": 3, "relation_claims": 3, "relation_skipped": 0, "relation_ratio": 1.0, "dated_claims": 0, "year_mentions": 0, "quantity_claims": 0, "quantity_mentions": 0, "stance_mentions": 0, "stance_claims": 0, "stance_skipped": 0}, "claims_schema": 6, "claims_text_hash": "d3b983c4dd973378"}
