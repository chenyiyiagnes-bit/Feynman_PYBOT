{"id": "bio-018", "type": "biography", "title": "量子电动力学", "text": "他与施温格、朝永振一郎各自做出的量子电动力学，解决了电子自能发散，1965年三人共获诺贝尔奖。", "tags": ["生平", "传记", "物理", "QED"], "source": "《理查德·费曼传》劳伦斯·M·克劳斯 p.144", "year": 1948, "beyond_1946": true, "aliases": ["QED", "电子自能", "重整化", "量子电动力学"], "source_class": "project_compilation", "verification_status": "unreviewed", "source_note": "未归类，按项目整理处理", "claims": [{"kind": "dated", "subject": "费曼", "event": "获奖", "year": "1965", "polarity": "assert", "unique_event": false, "ambiguous": false, "span": [33, 45], "quote": "1965年三人共获诺贝尔", "clause": "1965年三人共获诺贝尔奖"}], "claims_skipped": [], "claim_coverage": {"schema": 6, "chars": 47, "person_mentions": 0, "relation_words": 0, "relation_attachable": 0, "relation_claims": 0, "relation_skipped": 0, "relation_ratio": null, "dated_claims": 1, "year_mentions": 1, "quantity_claims": 0, "quantity_mentions": 0, "stance_mentions": 0, "stance_claims": 0, "stance_skipped": 0}, "claims_schema": 6, "claims_text_hash": "9ae140e30c9cbe08"}
